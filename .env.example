# LLM (OpenAI-compatible; DeepSeek / Hunyuan / etc.)
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Or provider-specific (example: Hunyuan TokenHub)
# LLM_PROVIDER=hunyuan
# HUNYUAN_API_KEY=sk-xxxxxxxx
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# HUNYUAN_MODEL=hy3
# HUNYUAN_VISION_MODEL=hy-vision-2.0-instruct

# AI day planner (1/true on, 0/false off → static cold-start templates)
USE_AI_GOD_PLANNER=1

# EasyOCR
OCR_USE_GPU=0

# Optional DingTalk alert webhook
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
